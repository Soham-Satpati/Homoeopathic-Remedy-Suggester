<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exceptions for HoRUS.app (used when signing with a Developer ID). -->
<plist version="1.0">
<dict>
    <!-- Dictation and the patient questionnaire's voice answers. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Python (ctypes, cffi in cryptography) needs writable+executable memory. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Python extension modules and Qt plugins are loaded from inside the bundle. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
